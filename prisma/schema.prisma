generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  PENDING_PAYMENT
  ACTIVE
  SUBMITTED
  COMPLETED
  DISPUTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  EARNING
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NotificationType {
  SYSTEM
  MESSAGE
  PROPOSAL
  CONTRACT
  PAYMENT
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  googleId     String?    @unique
  authProvider String     @default("LOCAL")
  role         Role       @default(USER)
  isSuspended  Boolean    @default(false)
  fcmToken     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile      Profile?
  resetTokens  PasswordResetToken[]
  services     Service[]
  projects     Project[]
  proposals    Proposal[]
  sentMessages Message[]  @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reviewsGiven   Review[] @relation("Reviewer")
  reviewsReceived Review[] @relation("Reviewee")
  wallet       Wallet?
  notifications Notification[]
}

model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  firstName  String
  lastName   String
  avatarUrl  String?
  bio        String?
  title      String?
  hourlyRate Float?
  skills     String[]
  averageRating Float?  @default(0)
  totalReviews  Int     @default(0)
}

model Service {
  id           String   @id @default(uuid())
  freelancerId String
  freelancer   User     @relation(fields: [freelancerId], references: [id])
  title        String
  category     String
  description  String
  price        Float
  deliveryDays Int
  imageUrl     String?
  createdAt    DateTime @default(now())

  @@index([freelancerId])
}

model Project {
  id          String        @id @default(uuid())
  clientId    String
  client      User          @relation(fields: [clientId], references: [id])
  title       String
  description String
  budget      Float
  timeline    String?
  status      ProjectStatus @default(DRAFT)
  skills      String[]
  createdAt   DateTime      @default(now())
  proposals   Proposal[]
  contracts   Contract[]

  @@index([clientId])
}

model Proposal {
  id           String         @id @default(uuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id])
  freelancerId String
  freelancer   User           @relation(fields: [freelancerId], references: [id])
  bidAmount    Float
  deliveryDays Int
  coverLetter  String
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  contract     Contract?

  @@index([projectId, freelancerId])
}

model Contract {
  id           String         @id @default(uuid())
  proposalId   String?        @unique
  proposal     Proposal?      @relation(fields: [proposalId], references: [id])
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id])
  clientId     String
  freelancerId String
  amount       Float
  status       ContractStatus @default(PENDING_PAYMENT)
  createdAt    DateTime       @default(now())
  
  reviews      Review[]
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Review {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id])
  reviewerId  String
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  @@unique([contractId, reviewerId]) // A user can only review a specific contract once
  @@index([revieweeId])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Float    @default(0)
  escrow    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id])
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  referenceId String?
  createdAt   DateTime          @default(now())
  
  @@index([walletId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

